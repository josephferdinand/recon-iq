# Configure only your NEW personal project. Never commit populated secrets.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_NEW_PUBLIC_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_NEW_PUBLIC_KEY
# Server-only bindings, never VITE-prefixed:
SUPABASE_SERVICE_ROLE_KEY=
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MUSE_MODEL=muse-spark-1.3
# Optional: OpenAI-compatible AI proxy. When BOTH values are set it becomes the
# platform AI fallback (Meta Muse above stays the default when unset).
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_FALLBACK_MODELS=
APP_DATA_ENC_KEY=
ENVIRONMENT_PACKAGE_HMAC_KEY=
