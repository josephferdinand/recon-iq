{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fvi-aidp-document-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "prod": { "name": "fvi-aidp-document-service-prod", "ai": { "binding": "AI" } },
    "dev": { "name": "fvi-aidp-document-service-dev", "ai": { "binding": "AI" } },
  },
}
