{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fvi-connector-gateway-prod",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "env": {
    "dev": {
      "name": "fvi-connector-gateway-dev",
      "workers_dev": false,
      "preview_urls": false,
    },
  },
}
