{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fvi-environment-ingress-prod",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "TARGET_ENVIRONMENT": "prod",
    "TARGET_PROJECT_REF": "YOUR_PROJECT_REF",
    "TARGET_SUPABASE_URL": "https://YOUR_PROJECT_REF.supabase.co",
    "DEV_SUPABASE_URL": "https://YOUR_PROJECT_REF.supabase.co",
  },
  "env": {
    "dev": {
      "name": "fvi-environment-ingress-dev",
      "vars": {
        "TARGET_ENVIRONMENT": "dev",
        "TARGET_PROJECT_REF": "YOUR_PROJECT_REF",
        "TARGET_SUPABASE_URL": "https://YOUR_PROJECT_REF.supabase.co",
        "PROD_SUPABASE_URL": "https://YOUR_PROJECT_REF.supabase.co",
      },
    },
    "uat": {
      "name": "fvi-environment-ingress-uat",
      "vars": {
        "TARGET_ENVIRONMENT": "uat",
        "TARGET_PROJECT_REF": "",
        "TARGET_SUPABASE_URL": "",
        "DEV_SUPABASE_URL": "https://YOUR_PROJECT_REF.supabase.co",
        "PROD_SUPABASE_URL": "https://YOUR_PROJECT_REF.supabase.co",
      },
    },
  },
}
